# Local development only. Do not put production secrets in this file.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://nexo:nexo@127.0.0.1:5432/nexo
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

DOCUMENT_MAX_BYTES=10485760
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200

# Required only when ingesting documents or embedding a question.
# The process starts without it.
# EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=30

# Required only when a question has a close source. Independent of the embedding key.
# The process starts without it. Completions use EMBEDDING_BASE_URL.
# COMPLETION_API_KEY=
COMPLETION_MODEL=gpt-4o-mini
COMPLETION_TIMEOUT=30
COMPLETION_MAX_TOKENS=800

QUERY_MAX_DISTANCE=0.5
QUERY_MATCH_LIMIT=5
QUERY_MAX_CHARS=2000
