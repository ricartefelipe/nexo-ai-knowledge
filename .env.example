# Local development only. Do not put production secrets in this file.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://nexo:nexo@127.0.0.1:5432/nexo
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# LLM and embedding settings are intentionally absent.
# v0.1.0 does not read provider credentials and starts without them.
